# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy csproj files
COPY ["src/Domain/Domain.csproj", "src/Domain/"]
COPY ["src/Jobs/Jobs.csproj", "src/Jobs/"]
COPY ["src/WebApp/WebApp.csproj", "src/WebApp/"]

# Restore dependencies
RUN dotnet restore "src/Jobs/Jobs.csproj"

# Copy everything else
COPY . .

# Build
WORKDIR "/src/src/Jobs"
RUN dotnet build "Jobs.csproj" -c Release -o /app/build

# Publish
FROM build AS publish
RUN dotnet publish "Jobs.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

EXPOSE 5002

COPY --from=publish /app/publish .

# Graceful shutdown configuration
ENV DOTNET_SHUTDOWNTIMEOUTSECONDS=30

ENTRYPOINT ["dotnet", "Jobs.dll"]

