{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=vkord;Username=vkord_user;Password=${DB_PASSWORD}"
  },
  "VkOrdConfiguration": {
    "BaseUrl": "https://advertisement-api VK.ru",
    "TimeoutSeconds": 30
  },
  "OpenRouterSettings": {
    "BaseUrl": "https://openrouter.ai",
    "ApiKey": "${OPENROUTER_API_KEY}",
    "TimeoutSeconds": 30,
    "Model": "x-ai/grok-4-fast:free"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "VkOrdApiWrapper",
    "Audience": "VkOrdApiWrapper",
    "ExpiryMinutes": 1440
  },
  "DaDataSettings": {
    "BaseUrl": "https://suggestions.dadata.ru/suggestions/api/4_1/rs/",
    "ApiToken": "${DADATA_API_TOKEN}",
    "TimeoutSeconds": 30
  },
  "RedisSettings": {
    "ConnectionString": "redis:6379",
    "InstanceName": "VkOrdApi",
    "DefaultDatabase": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz",
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    },
    "File": {
      "Path": "logs/vkord-api-.txt",
      "RollingInterval": "Day",
      "RollingSizeKB": 10240
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vkord-api-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  }
}

