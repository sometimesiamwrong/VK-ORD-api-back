{
  "Jobs": {
    "ErirSyncIntervalMinutes": 5,
    "EnabledEntityTypes": [
      "Counterparty",
      "Contract",
      "Creative",
      "Invoice",
      "Statistic"
    ],
    "BatchSize": 60000,
    "ContinueOnError": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vkordapi;Username=postgres;Password=postgres;"
  },
  "VkOrd": {
    "Production": {
      "BaseUrl": "https://api.vk.com/ord/v1",
      "TokenUrl": "https://oauth.vk.com/access_token",
      "ApiVersion": "5.131"
    },
    "Development": {
      "BaseUrl": "https://api.vk.com/ord-dev/v1",
      "TokenUrl": "https://oauth.vk.com/access_token",
      "ApiVersion": "5.131"
    },
    "RetryPolicy": {
      "RetryCount": 3,
      "BackoffPower": 2,
      "InitialDelayMs": 100
    },
    "ConcurrencySettings": {
      "MaxParallelRequests": 5,
      "RateLimitPerMinute": 100
    }
  },
  "Hangfire": {
    "WorkerCount": 1
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/jobs-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
