<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Jobs</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <!-- Исключить содержимое WebApp при публикации -->
        <EnableDefaultContentItems>true</EnableDefaultContentItems>
    </PropertyGroup>

    <!-- Исключить appsettings файлы из WebApp при публикации -->
    <ItemGroup>
        <Content Remove="..\WebApp\appsettings.json" />
        <Content Remove="..\WebApp\appsettings.*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- Hangfire -->
        <PackageReference Include="Hangfire.Core" Version="1.8.14" />
        <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
        <PackageReference Include="Hangfire.PostgreSql" Version="1.20.9" />

        <!-- Entity Framework -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Refit -->
        <PackageReference Include="Refit" Version="8.0.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />

        <!-- Logging -->
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

        <!-- HTTP and Polly -->
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.11" />
        <PackageReference Include="Polly" Version="8.6.4" />
        <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />

        <!-- JSON -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Domain\Domain.csproj" />
        <!-- Ссылка на WebApp - нужна для использования репозиториев и сервисов -->
        <ProjectReference Include="..\WebApp\WebApp.csproj">
            <!-- Исключаем все content-файлы из WebApp при публикации -->
            <ExcludeAssets>contentFiles</ExcludeAssets>
            <PrivateAssets>contentFiles</PrivateAssets>
        </ProjectReference>
    </ItemGroup>

    <!-- Явно исключить конфликтующие файлы из WebApp -->
    <Target Name="RemoveWebAppContentFiles" BeforeTargets="Build">
        <ItemGroup>
            <Content Remove="@(Content)" Condition="'%(Content.Link)' != '' AND $([System.String]::Copy('%(Content.Link)').StartsWith('appsettings'))" />
        </ItemGroup>
    </Target>

    <!-- Исключить content-файлы WebApp из публикации -->
    <Target Name="ExcludeWebAppFilesFromPublish" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <!-- Исключить appsettings из WebApp -->
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" 
                Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings')) AND 
                           $([System.String]::Copy('%(ResolvedFileToPublish.SourcePath)').Contains('WebApp'))" />
            
            <!-- Исключить другие content-файлы WebApp если нужно -->
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" 
                Condition="'%(ResolvedFileToPublish.AssetType)' == 'content' AND 
                           $([System.String]::Copy('%(ResolvedFileToPublish.SourcePath)').Contains('WebApp'))" />
        </ItemGroup>
    </Target>

</Project>
